 journal = {Astronomy and Astrophysics},
 keywords = {cosmology: observations, gravitational lensing: weak, galaxies: photometry, surveys, Astrophysics - Cosmology and Nongalactic Astrophysics, Astrophysics - Instrumentation and Methods for Astrophysics},
