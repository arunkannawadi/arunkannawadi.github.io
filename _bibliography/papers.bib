 author = {{Tr{\"o}ster}, Tilman and {Mead}, Alexander J. and {Heymans}, Catherine and {Yan}, Ziang and {Alonso}, David and {Asgari}, Marika and {Bilicki}, Maciej and {Dvornik}, Andrej and {Hildebrandt}, Hendrik and {Joachimi}, Benjamin and {Kannawadi}, Arun and {Kuijken}, Konrad and {Schneider}, Peter and {Shan}, Huan Yuan and {van Waerbeke}, Ludovic and {Wright}, Angus H.},
 bibtex_show = {true},
