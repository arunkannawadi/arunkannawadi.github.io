 keywords = {Astrophysics - Cosmology and Nongalactic Astrophysics},
 month = {December},
 number = {12},
 pages = {123518},
 primaryclass = {astro-ph.CO},
 title = {{Hyper Suprime-Cam Year 3 results: Cosmology from cosmic shear two-point correlation functions}},
