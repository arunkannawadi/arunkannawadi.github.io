 archiveprefix = {arXiv},
 arxiv = {2007.15635},
 author = {{Hildebrandt}, H. and {van den Busch}, J.~L. and {Wright}, A.~H. and {Blake}, C. and {Joachimi}, B. and {Kuijken}, K. and {Tr{\"o}ster}, T. and {Asgari}, M. and {Bilicki}, M. and {de Jong}, J.~T.~A. and {Dvornik}, A. and {Erben}, T. and {Getman}, F. and {Giblin}, B. and {Heymans}, C. and {Kannawadi}, A. and {Lin}, C.-A. and {Shan}, H.-Y.},
