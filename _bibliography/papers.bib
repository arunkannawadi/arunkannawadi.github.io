 bibtex_show = {true},
 custom_keywords = {major},
 doi = {10.1051/0004-6361/202039254},
 eid = {A175},
 eprint = {2009.00367},
 journal = {Astronomy and Astrophysics},
 keywords = {gravitational lensing: weak, methods: statistical, surveys, cosmology: observations, Astrophysics - Cosmology and Nongalactic Astrophysics},
 month = {February},
 pages = {A175},
 primaryclass = {astro-ph.CO},
 title = {{KiDS+VIKING-450: An internal-consistency test for cosmic shear tomography with a colour-based split of source galaxies}},
