@inproceedings{2025AAS...24542107K,
 abstract = {{In this talk, I will introduce a new technique in development, dubbed as
wake lensing. Massive compact objects such as black holes moving
through the dark matter halo of the Milky Way leaves behind a
small wake of overdensity behind. I will show the overdensity
profile computed from N-body simulations and their potential to
be observed from upcoming time-domain surveys such as Rubin
Observatory/LSST and Roman Space Telescope.}},
